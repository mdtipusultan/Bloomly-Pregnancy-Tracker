            "value": "Вага до вагітності допомагає відстежувати здорове зростання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cân nặng trước khi mang thai giúp theo dõi tăng cân lành mạnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        }
      }
