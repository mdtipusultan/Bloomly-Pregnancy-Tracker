    "home.planningSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع دورتك واستعدي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চক্র ট্র্যাক করুন এবং যাত্রার জন্য প্রস্তুত হন।"
