    "settings.language.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق تغييرات اللغة في جميع أنحاء التطبيق، بما في ذلك أدلة الأسابيع والنصائح اليومية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষা পরিবর্তন পুরো অ্যাপে প্রযোজ্য, যার মধ্যে সপ্তাহ গাইড এবং দৈনিক টিপস অন্তর্ভুক্ত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachänderungen gelten in der gesamten App, einschließlich Wochenführern und Tagestipps."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές γλώσσας ισχύουν σε όλη την εφαρμογή, συμπεριλαμβανομένων των εβδομαδιαίων οδηγών και των ημερήσιων συμβουλών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Language changes apply across the app, including week guides and daily tips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de idioma se aplican en toda la app, incluidas las guías semanales y los consejos diarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements de langue s'appliquent dans toute l'application, y compris les guides hebdomadaires et les conseils quotidiens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויי שפה חלים על כל האפליקציה, כולל מדריכים שבועיים וטיפים יומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा परिवर्तन पूरे ऐप में लागू होते हैं, जिसमें सप्ताह गाइड और दैनिक सुझाव शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan bahasa berlaku di seluruh aplikasi, termasuk panduan mingguan dan tips harian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche alla lingua si applicano in tutta l'app, incluse le guide settimanali e i consigli giornalieri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更は、アプリ全体に適用され、週ごとのガイドと毎日のヒントも含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 변경은 주간 가이드와 일일 팁을 포함하여 앱 전체에 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan bahasa terpakai di seluruh aplikasi, termasuk panduan minggu dan tip harian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taalswijzigingen gelden in de hele app, inclusief weekgidsen en dagelijkse tips."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany języka obowiązują w całej aplikacji, w tym przewodniki tygodniowe i codzienne wskazówki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de idioma aplicam-se em toda a app, incluindo guias semanais e dicas diárias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările de limbă se aplică în întreaga aplicație, inclusiv ghidurile săptămânale și sfaturile zilnice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения языка применяются во всём приложении, включая недельные руководства и ежедневные советы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Språkändringar gäller i hela appen, inklusive veckoguider och dagliga tips."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนภาษามีผลทั่วทั้งแอป รวมถึงคู่มือรายสัปดาห์และเคล็ดลับประจำวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil değişiklikleri, haftalık rehberler ve günlük ipuçları dahil olmak üzere uygulamanın tamamında geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни мови застосовуються в усьому додатку, включно з тижневими гідами та щоденними порадами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi ngôn ngữ áp dụng trên toàn bộ ứng dụng, bao gồm hướng dẫn theo tuần và mẹo hàng ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言更改适用于整个应用，包括每周指南和每日提示。"
          }
        }
      }
    },
