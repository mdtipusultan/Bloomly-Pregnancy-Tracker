          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійний приватний простір для кожного моменту — від першого руху до зворотного відліку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian riêng tư, yên bình cho mọi khoảnh khắc — từ cử động đầu tiên đến đếm ngược cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        }
      }
