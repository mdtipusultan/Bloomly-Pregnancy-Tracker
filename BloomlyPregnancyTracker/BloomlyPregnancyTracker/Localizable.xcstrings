    "profile.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly يخزن بياناتك على جهازك فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly আপনার সমস্ত ডেটা শুধুমাত্র আপনার ডিভাইসে সংরক্ষণ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly speichert alle Daten nur auf deinem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Bloomly αποθηκεύει όλα τα δεδομένα σας αποκλειστικά στη συσκευή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly stores all your data exclusively on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly guarda todos tus datos solo en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly stocke vos données uniquement sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly שומר את כל הנתונים שלך רק במכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly आपका डेटा केवल आपके डिवाइस पर रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly menyimpan semua data hanya di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly conserva i dati solo sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomlyはデータを端末内にのみ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly는 기기에만 데이터를 저장합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly menyimpan semua data hanya pada peranti anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly slaat data alleen op je apparaat op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly przechowuje dane tylko na urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly armazena dados apenas no seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly stochează toate datele exclusiv pe dispozitivul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly хранит данные только на устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly lagrar all din data enbart på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly เก็บข้อมูลทั้งหมดบนอุปกรณ์ของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly verileri yalnızca cihazınızda saklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly зберігає всі дані лише на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly lưu trữ mọi dữ liệu chỉ trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomly 将所有数据仅存于您的设备。"
          }
        }
      }
    },
