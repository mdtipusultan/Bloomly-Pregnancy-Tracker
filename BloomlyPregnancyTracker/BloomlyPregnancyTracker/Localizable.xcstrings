    "profile.privacyFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك لا تغادر iPhone إلا عبر iCloud/iTunes."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud বা iTunes ব্যাকআপ ছাড়া আপনার ডেটা iPhone ছাড়ে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten verlassen dein iPhone nur via iCloud/iTunes-Backup."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα σας δεν φεύγουν από το iPhone σας, εκτός αν κάνετε backup μέσω iCloud ή iTunes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data never leaves your iPhone unless you back up via iCloud or iTunes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos no salen de tu iPhone salvo copia iCloud/iTunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données ne quittent pas votre iPhone sauf sauvegarde iCloud/iTunes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים לא עוזבים את האייפון אלא אם גיבית ב-iCloud או iTunes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा iCloud/iTunes बैकअप के बिना iPhone नहीं छोड़ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tidak meninggalkan iPhone kecuali backup via iCloud atau iTunes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati non lasciano il tuo iPhone salvo backup iCloud/iTunes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud/iTunesバックアップ以外は端末外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud/iTunes 백업 외에는 기기를 벗어나지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tidak meninggalkan iPhone melainkan sandaran melalui iCloud atau iTunes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data verlaat je iPhone niet behalve via iCloud/iTunes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane nie opuszczają iPhone bez kopii iCloud/iTunes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados não saem do iPhone exceto backup iCloud/iTunes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele nu părăsesc iPhone-ul decât dacă faci backup prin iCloud sau iTunes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не покидают iPhone без резервной копии iCloud/iTunes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina data lämnar inte din iPhone om du inte säkerhetskopierar via iCloud eller iTunes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลไม่ออกจาก iPhone เว้นแต่สำรองผ่าน iCloud หรือ iTunes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler iCloud/iTunes yedekleme dışında iPhone'dan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані не залишають iPhone, якщо не робите резервну копію через iCloud або iTunes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu không rời iPhone trừ khi sao lưu qua iCloud hoặc iTunes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据不会离开 iPhone，除非通过 iCloud/iTunes 备份。"
          }
        }
      }
    },
