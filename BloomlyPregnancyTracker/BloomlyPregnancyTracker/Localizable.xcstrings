    "weekGuide.tipBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Stay hydrated and eat balanced meals this week. Small, frequent snacks can help with comfort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente hidratada y come comidas equilibradas esta semana. Los bocadillos pequeños y frecuentes pueden ayudar a tu bienestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez hydratée et mangez équilibré cette semaine. De petites collations fréquentes peuvent améliorer votre confort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie diese Woche hydratisiert und essen Sie ausgewogen. Kleine, häufige Snacks können für mehr Wohlbefinden sorgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta idratata e mangia pasti equilibrati questa settimana. Spuntini piccoli e frequenti possono aiutare il tuo benessere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se hidratada e faça refeições equilibradas esta semana. Lanches pequenos e frequentes podem ajudar no conforto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظي على الترطيب وتناولي وجبات متوازنة هذا الأسبوع. الوجبات الخفيفة الصغيرة والمتكررة قد تساعد على الراحة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सप्ताह हाइड्रेटेड रहें और संतुलित भोजन करें। छोटे, बार-बार स्नैक्स आराम में मदद कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সপ্তাহে হাইড্রেটেড থাকুন এবং সুষম খাবার খান। ছোট, ঘন ঘন স্ন্যাকস আরামে সাহায্য করতে পারে।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週は水分補給を心がけ、バランスの取れた食事を。小さな間食をこまめにとると快適さにつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에는 수분을 충분히 섭취하고 균형 잡힌 식사를 하세요. 작고 자주 먹는 간식이 편안함에 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周保持水分摄入，均衡饮食。少量多次的零食有助于舒适。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой неделе пейте достаточно воды и ешьте сбалансированно. Небольшие частые перекусы помогут чувствовать себя комфортнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього тижня пийте достатньо води та їжте збалансовано. Невеликі часті перекуси допоможуть почуватися комфортніше."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf deze week goed hydrateren en eet gebalanceerde maaltijden. Kleine, frequente snacks kunnen helpen voor comfort."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll dig hydrerad och ät balanserade måltider den här veckan. Små, frekventa mellanmål kan öka komforten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta susuz kalmayın ve dengeli beslenin. Küçük, sık atıştırmalıklar konforunuzu artırabilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym tygodniu dbaj o nawodnienie i zbilansowane posiłki. Małe, częste przekąski mogą poprawić komfort."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần này hãy giữ đủ nước và ăn uống cân bằng. Ăn nhẹ thường xuyên có thể giúp bạn thoải mái hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัปดาห์นี้ดื่มน้ำให้เพียงพอและรับประทานอาหารที่สมดุล ของว่างเล็กๆ บ่อยครั้งช่วยให้สบายตัวได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap terhidrasi dan makan makanan seimbang minggu ini. Camilan kecil yang sering dapat membantu kenyamanan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal terhidrat dan makan makanan seimbang minggu ini. Snek kecil yang kerap boleh membantu keselesaan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרי על לחות ואכלי ארוחות מאוזנות השבוע. חטיפים קטנים ותכופים יכולים לעזור לנוחות."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείνετε ενυδατωμένη και τρώτε ισορροπημένα αυτή την εβδομάδα. Μικρά, συχνά σνακ μπορούν να βοηθήσουν στην άνεση."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâi hidratată și mănâncă echilibrat săptămâna aceasta. Gustările mici și frecvente pot ajuta la confort."
          }
        }
      }
    },
