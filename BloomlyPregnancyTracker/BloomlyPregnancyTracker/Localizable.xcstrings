    "onboarding.welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি মুহূর্ত ট্র্যাক করার জন্য একটি শান্ত, ব্যক্তিগত স্থান — প্রথম নাড় থেকে শেষ গণনা পর্যন্ত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ήρεμος, ιδιωτικός χώρος για κάθε στιγμή — από το πρώτο φτερούγισμα μέχρι την τελική αντίστροφη μέτρηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio tranquilo y privado para seguir cada momento, desde el primer aleteo hasta la cuenta regresiva final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מרחב שקט ופרטי לכל רגע — מהרעד הראשון ועד הספירה לאחור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang tenang dan pribadi untuk setiap momen — dari gerakan pertama hingga hitung mundur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang tenang dan peribadi untuk setiap detik — dari gerakan pertama hingga kira detik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private space to track every moment — from first flutter to final countdown."
          }
        },
        "pt": {
