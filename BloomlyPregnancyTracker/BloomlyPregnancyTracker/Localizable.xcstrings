    "weekGuide.development %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Week %lld brings new growth milestones. Your baby's organs and systems continue developing rapidly during this stage of pregnancy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semana %lld trae nuevos hitos de crecimiento. Los órganos y sistemas de tu bebé siguen desarrollándose rápidamente durante esta etapa del embarazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La semaine %lld apporte de nouveaux jalons de croissance. Les organes et systèmes de votre bébé continuent de se développer rapidement à ce stade de la grossesse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woche %lld bringt neue Wachstumsmeilensteine. Die Organe und Systeme Ihres Babys entwickeln sich in dieser Schwangerschaftsphase weiterhin rasch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La settimana %lld porta nuovi traguardi di crescita. Gli organi e i sistemi del tuo bambino continuano a svilupparsi rapidamente in questa fase della gravidanza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A semana %lld traz novos marcos de crescimento. Os órgãos e sistemas do seu bebé continuam a desenvolver-se rapidamente nesta fase da gravidez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسبوع %lld يجلب معالم نمو جديدة. تستمر أعضاء وجهاز طفلك في التطور بسرعة خلال هذه المرحلة من الحمل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह %lld नए विकास के मील के पत्थर लाता है। गर्भावस्था के इस चरण में आपके बच्चे के अंग और तंत्र तेज़ी से विकसित होते रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সপ্তাহ %lld নতুন বৃদ্ধির মাইলফলক নিয়ে আসে। গর্ভাবস্থার এই পর্যায়ে আপনার শিশুর অঙ্গ-প্রতঙ্গ ও সিস্টেম দ্রুত গড়ে উঠতে থাকে।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第%lld週は新しい成長の節目を迎えます。この時期、赤ちゃんの臓器や体の仕組みは引き続き急速に発達しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld주는 새로운 성장 이정표를 가져옵니다. 임신 이 시기에 아기의 장기와 신체 계통은 계속 빠르게 발달합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 周带来新的成长里程碑。在这一孕期阶段，宝宝的器官和系统仍在快速发育。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неделя %lld приносит новые этапы роста. Органы и системы вашего малыша продолжают быстро развиваться на этом этапе беременности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиждень %lld приносить нові етапи зростання. Органи та системи вашої дитини продовжують швидко розвиватися на цьому етапі вагітності."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Week %lld brengt nieuwe groeimijlpalen. De organen en systemen van je baby blijven zich in deze fase van de zwangerschap snel ontwikkelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecka %lld innebär nya tillväxtmilstolpar. Ditt barns organ och system fortsätter att utvecklas snabbt under detta skede av graviditeten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. hafta yeni büyüme dönüm noktaları getirir. Bebeğinizin organları ve sistemleri hamileliğin bu evresinde hızla gelişmeye devam eder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tydzień %lld przynosi nowe etapy rozwoju. Narządy i układy Twojego dziecka nadal szybko rozwijają się na tym etapie ciąży."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần %lld mang đến những cột mốc phát triển mới. Các cơ quan và hệ thống của em bé tiếp tục phát triển nhanh chóng trong giai đoạn thai kỳ này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัปดาห์ที่ %lld นำพาเหตุการณ์สำคัญด้านการเติบโตใหม่ๆ อวัยวะและระบบต่างๆ ของลูกน้อยยังคงพัฒนาอย่างรวดเร็วในช่วงของการตั้งครรภ์นี้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu %lld membawa tonggak pertumbuhan baru. Organ dan sistem bayi Anda terus berkembang pesat pada tahap kehamilan ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu %lld membawa pencapaian pertumbuhan baharu. Organ dan sistem bayi anda terus berkembang pesat pada peringkat kehamilan ini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבוע %lld מביא אבני דרך חדשות בצמיחה. האיברים והמערכות של התינוק/ת ממשיכים להתפתח במהירות בשלב זה של ההריון."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εβδομάδα %lld φέρνει νέα ορόσημα ανάπτυξης. Τα όργανα και τα συστήματα του μωρού σας συνεχίζουν να αναπτύσσονται γρήγορα σε αυτό το στάδιο της εγκυμοσύνης."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Săptămâna %lld aduce noi repere de creștere. Organele și sistemele bebelușului continuă să se dezvolte rapid în această etapă a sarcinii."
          }
        }
      }
    },
    "weekGuide.momFeeling %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You may notice changing energy levels and body sensations typical of week %lld. Listen to your body and rest when needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes notar cambios en tu energía y sensaciones corporales típicas de la semana %lld. Escucha a tu cuerpo y descansa cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez remarquer des changements d'énergie et des sensations corporelles typiques de la semaine %lld. Écoutez votre corps et reposez-vous au besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können veränderte Energie und Körperempfindungen bemerken, die für Woche %lld typisch sind. Hören Sie auf Ihren Körper und ruhen Sie sich aus, wenn nötig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti notare cambiamenti di energia e sensazioni corporee tipiche della settimana %lld. Ascolta il tuo corpo e riposati quando serve."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode notar mudanças de energia e sensações corporais típicas da semana %lld. Ouça o seu corpo e descanse quando precisar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تلاحظين تغيرات في مستوى الطاقة وإحساسات جسدية شائعة للأسبوع %lld. استمعي لجسمك وارتاحي عند الحاجة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सप्ताह %lld के लिए विशिष्ट ऊर्जा स्तर और शारीरिक संवेदनाएँ महसूस कर सकती हैं। अपने शरीर की सुनें और जरूरत पड़ने पर आराम करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সপ্তাহ %lld-এর জন্য সাধারণ শক্তির পরিবর্তন ও শারীরিক অনুভূতি লক্ষ করতে পারেন। শরীরের কথা শুনুন এবং প্রয়োজনে বিশ্রাম নিন।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第%lld週ならではのエネルギーの変化や身体の感覚に気づくかもしれません。体の声を聞き、必要なときは休息を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld주에 흔한 에너지 변화와 몸의 감각을 느낄 수 있습니다. 몸의 신호에 귀 기울이고 필요할 때 쉬세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可能会注意到第 %lld 周典型的精力变化和身体感受。倾听身体，需要时休息。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете заметить изменения энергии и телесные ощущения, типичные для недели %lld. Прислушивайтесь к телу и отдыхайте при необходимости."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете помітити зміни енергії та тілесні відчуття, типові для тижня %lld. Прислухайтеся до тіла та відпочивайте за потреби."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je merkt misschien veranderingen in energie en lichaamsgevoelens die typisch zijn voor week %lld. Luister naar je lichaam en rust wanneer nodig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan märka förändrade energinivåer och kroppsliga förnimmelser som är typiska för vecka %lld. Lyssna på kroppen och vila när du behöver."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. haftaya özgü enerji değişimleri ve bedensel hisler fark edebilirsiniz. Vücudunuzu dinleyin ve gerektiğinde dinlenin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zauważyć zmiany energii i odczucia ciała typowe dla tygodnia %lld. Słuchaj swojego ciała i odpoczywaj, gdy potrzebujesz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể nhận thấy mức năng lượng và cảm giác cơ thể thay đổi điển hình của tuần %lld. Lắng nghe cơ thể và nghỉ ngơi khi cần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอาจสังเกตเห็นระดับพลังงานและความรู้สึกทางร่างกายที่เป็นลักษณะเฉพาะของสัปดาห์ที่ %lld ฟังร่างกายของคุณและพักผ่อนเมื่อจำเป็น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mungkin merasakan perubahan energi dan sensasi tubuh yang khas untuk minggu %lld. Dengarkan tubuh Anda dan istirahat saat diperlukan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mungkin perasan perubahan tenaga dan sensasi badan yang biasa untuk minggu %lld. Dengar badan anda dan berehat apabila perlu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שתשימי לב לשינויים ברמת האנרגיה ולתחושות גוף האופייניות לשבוע %lld. הקשיבי לגוף ונוחי כשצריך."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να παρατηρήσετε αλλαγές στην ενέργεια και σωματικές αισθήσεις τυπικές της εβδομάδας %lld. Ακούστε το σώμα σας και ξεκουραστείτε όταν χρειάζεται."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil să observi schimbări de energie și senzații corporale tipice săptămânii %lld. Ascultă-ți corpul și odihnește-te când ai nevoie."
          }
        }
      }
    },
    "weekGuide.appointment.firstPrenatal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "First prenatal visit often scheduled around weeks 8–10"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera visita prenatal suele programarse entre las semanas 8 y 10"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première visite prénatale est souvent prévue autour des semaines 8 à 10"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Vorsorgetermin wird oft für Woche 8–10 geplant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima visita prenatale è spesso programmata tra le settimane 8 e 10"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira consulta pré-natal costuma ser marcada entre as semanas 8 e 10"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غالباً ما يُحدَّد موعد الزيارة الأولى قبل الولادة حول الأسابيع 8–10"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली प्रसवपूर्व जांच अक्सर 8–10 सप्ताह के आसपास निर्धारित होती है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম প্রসবপূর্ব সাক্ষাৎ প্রায় ৮–১০ সপ্তাহে নির্ধারিত হয়"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回の妊婦健診は8〜10週ごろに予定されることが多いです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 산전 진료는 보통 8–10주경에 예약됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次产检通常安排在第 8–10 周左右"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый дородовой визит часто назначают на 8–10 неделе"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший дородовий візит часто призначають на 8–10 тижні"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het eerste prenatale consult wordt vaak rond week 8–10 ingepland"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första mödrahälsovårdsbesöket bokas ofta runt vecka 8–10"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk doğum öncesi kontrol genellikle 8–10. haftalarda planlanır"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza wizyta przedporodowa jest często zaplanowana na 8–10 tydzień"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần khám thai đầu tiên thường được hẹn vào khoảng tuần 8–10"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจครรภ์ครั้งแรกมักนัดในช่วงสัปดาห์ที่ 8–10"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunjungan prenatal pertama sering dijadwalkan sekitar minggu 8–10"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawatan pranatal pertama selalunya dijadualkan sekitar minggu 8–10"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הביקור הטרום-לידתי הראשון מתוזמן לרוב סביב שבועות 8–10"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρώτη προγεννητική επίσκεψη προγραμματίζεται συχνά γύρω στις εβδομάδες 8–10"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima vizită prenatală este adesea programată în jurul săptămânilor 8–10"
          }
        }
      }
    },
    "weekGuide.appointment.nuchal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nuchal translucency screening may be offered around week 12"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba de translucencia nucal puede ofrecerse alrededor de la semana 12"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépistage de la clarté nucale peut être proposé vers la semaine 12"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Nackentransparenz-Screening kann um Woche 12 angeboten werden"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo screening della translucenza nucale può essere offerto intorno alla settimana 12"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreio da translucência nucal pode ser oferecido por volta da semana 12"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يُعرَض فحص شفافية الرقبة حول الأسبوع 12"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
