    "weight.startingSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গর্ভাবস্থার আগের ওজন সুস্থ বৃদ্ধি ট্র্যাক করতে সাহায্য করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βάρος πριν την εγκυμοσύνη βοηθά στην παρακολούθηση υγιούς αύξησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משקל לפני ההריון עוזר לעקוב אחרי עלייה בריאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat sebelum hamil membantu melacak kenaikan sehat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat sebelum hamil membantu jejak kenaikan sihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Greutatea pre-sarcină ajută la urmărirea creșterii sănătoase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pre-pregnancy weight helps track healthy gain over time."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vikt före graviditet hjälper att spåra hälsosam viktuppgång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักก่อนตั้งครรภ์ช่วยติดตามการเพิ่มที่สุขภาพดี"
          }
        },
