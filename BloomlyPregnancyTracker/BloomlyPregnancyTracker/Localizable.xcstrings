            "state": "translated",
            "value": "周期を記録して準備しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기를 추적하고 준비하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
