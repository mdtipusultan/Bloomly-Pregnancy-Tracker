    "tools.kegel.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسك 5 ثوانٍ، أفلت 5 ثوانٍ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৫ সেকেন্ড ধরে রাখুন, ৫ সেকেন্ড ছাড়ুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Sek. halten, 5 Sek. loslassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε 5 δευτερόλεπτα, αφήστε 5 δευτερόλεπτα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for 5 seconds, release for 5 seconds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén 5 seg, suelta 5 seg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir 5 sec, relâcher 5 sec"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקי 5 שניות, שחררי 5 שניות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 सेकंड पकड़ें, 5 छोड़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan 5 detik, lepas 5 detik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni 5 sec, rilascia 5 sec"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5秒キープ、5秒リリース"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5초 유지, 5초 이완"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan 5 saat, lepas 5 saat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 sec vasthouden, 5 sec loslaten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj 5 sek, puść 5 sek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure 5 seg, solte 5 seg"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține 5 secunde, eliberează 5 secunde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать 5 сек, отпустить 5 сек"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll i 5 sekunder, släpp i 5 sekunder"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลั้น 5 วินาที คลาย 5 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 sn tut, 5 sn bırak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте 5 секунд, відпустіть 5 секунд"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
